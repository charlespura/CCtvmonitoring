{
  "name": "cctvmonitoring",
  "version": "1.0.0",
  "description": "Real-time CCTV monitoring dashboard with AI people counting for Tapo / RTSP cameras",
  "main": "stream-server.js",
  "scripts": {
    "start": "node stream-server.js",
    "dev": "nodemon stream-server.js --ignore public/",
    "check:python": "python3 -c \"import cv2, numpy; print('OpenCV', cv2.__version__)\""
  },
  "keywords": [
    "cctv",
    "rtsp",
    "people-counting",
    "opencv",
    "tapo",
    "websocket",
    "surveillance",
    "dashboard"
  ],
  "author": "Charles Pura",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/charlespura/CCtvmonitoring.git"
  }
}
